[Unit]
Description=LANtern network audit
After=network.target

[Service]
User=lantern
WorkingDirectory=/opt/lantern
EnvironmentFile=/etc/lantern.env
ExecStart=/opt/lantern/venv/bin/gunicorn -w 1 --threads 8 -b 127.0.0.1:8001 app:app
Restart=always
LimitNOFILE=65535
NoNewPrivileges=true
ProtectSystem=full
ReadWritePaths=/opt/lantern/data

[Install]
WantedBy=multi-user.target
